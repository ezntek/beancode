// PPM video generator!
// Run with `./main.py PPMVideo.bean | bash && ffmpeg -i frame%d.ppm -r 60 -o output.mp4` 
CONSTANT Width <- 640
CONSTANT Height <- 480
CONSTANT Max <- 60

PROCEDURE Frame(Name: STRING, I: INTEGER)
    WRITEFILE Name, "P3\n"

    WRITEFILE Name, Width + " " + Height + "\n"

    WRITEFILE Name, "255\n"

    DECLARE Data: STRING
    DECLARE Pixel: STRING

    Data <- ""

    FOR Y <- 0 TO (Height - 1)
        FOR X <- 0 TO (Width - 1)
            IF MOD(DIV(X + I, 40) + DIV(Y + I, 30), 2) = 0
              THEN
                Pixel <- 255 + " " + 0 + " " + 0
                // Pixel <- 79 + " " + 169 + " " + 232 + " "
              ELSE
                Pixel <- 0 + " " + 0 + " " + 0
                // Pixel <- 120 + " " + 187 + " " + 232 + " "
            ENDIF
            WRITEFILE Name, Pixel + "\n"
        NEXT X
    NEXT Y
ENDPROCEDURE

FOR i <- 0 TO (Max - 1)
    CONSTANT Name <- "./out/frame" + i + ".ppm"
    OPENFILE Name FOR WRITE

    CALL Frame(Name, i)
    CLOSEFILE Name

    OUTPUT "Written frame " + (i + 1) + " of " + Max
NEXT i
